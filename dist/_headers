# The headers will be auto applied to routes in Cloudflare Pages

# Cross-Origin Resource Sharing (CORS) headers
/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
  Access-Control-Allow-Headers: *

# JSON response type + long-lived caching for all routes in /pincode/*
# (files are regenerated rarely; SWR keeps responses fresh after re-exports)
/pincode/*
  Content-Type: application/json
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  X-Content-Type-Options: nosniff

/pincode/:pincode
  X-content-description: Details for ":pincode"
